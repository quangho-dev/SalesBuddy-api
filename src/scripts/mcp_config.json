{
  "google-sheets": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-google-sheets@latest"],
      "env": {
        "CREDENTIALS_PATH": "/Users/admin/.gmail-mcp/gcp-oauth.keys.json",
        "TOKEN_PATH": "/Users/admin/.gmail-mcp/token.json"
      },
      "transport": "stdio"
    },
  "google-drive": {
    "command": "uvx",
    "args": ["--with", "mcp<2", "mcp-google-drive@latest"],
    "env": {
      "CREDENTIALS_PATH": "/Users/admin/.gmail-mcp/gcp-oauth.keys.json",
      "TOKEN_PATH": "/Users/admin/.gmail-mcp/token.json"
    },
    "transport": "stdio"
  },
  "supabase": {
    "transport": "http",
    "url": "https://mcp.supabase.com/mcp?project_ref=mhhwvbvhavkgwtmmbqda&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
  }
}
